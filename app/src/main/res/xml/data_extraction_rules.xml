<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Never back up secrets or the encrypted keystore file, even to the user's own cloud. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="alphaai_secure_keys.xml" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="alphaai_secure_keys.xml" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
